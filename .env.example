# ── Backend switch ──────────────────────────────────────────
# mock     = no real persistence / fake auth
# supabase = Supabase Auth + /api/v1/* (current)
# http     = NEXT_PUBLIC_API_URL (Node later)
NEXT_PUBLIC_API_PROVIDER=supabase

# Used when PROVIDER=http (Node). Leave empty while on Supabase.
NEXT_PUBLIC_API_URL=

# Optional absolute site URL for auth redirects in non-browser contexts
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
