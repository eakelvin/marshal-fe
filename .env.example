# ── Backend switch ──────────────────────────────────────────
# mock     = no real persistence
# supabase = Next /api/v1/* → Supabase (current)
# http     = NEXT_PUBLIC_API_URL (Node later)
NEXT_PUBLIC_API_PROVIDER=supabase

# Used when PROVIDER=http (Node). Leave empty while on Supabase.
# NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
